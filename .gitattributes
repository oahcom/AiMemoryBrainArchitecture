# Line endings are a repository property, not an author property.
#
# Every text file this repository governs is LF in the object database, so a
# diff shows the change and not the host that produced it. Without this file a
# CRLF checkout commits CRLF blobs and the next one-line edit renders as a
# whole-file diff (see #766: +349/-349 for a 10-line change).
#
# `text=auto` normalises on add. The explicit per-type lines are redundant for
# the object database but make the intent readable and survive `text=auto`
# being turned off for a path by a later rule.

* text=auto

*.rs   text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.html text eol=lf

# Frozen prompt artifacts are evidence, and their byte count and SHA-256 are
# pinned in the registration record:
#   AID-2026-049/manifest.yaml: prompt_sha256 c4be14e2…, prompt_bytes 31989
# Those values are the raw CRLF blob on purpose. Renormalising this file would
# change it to 31034 bytes / 55045521… and silently invalidate a FROZEN prompt
# pin. It is therefore declared binary so neither Git nor the gate rewrites or
# flags it.
