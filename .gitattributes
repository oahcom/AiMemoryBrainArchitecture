# Line endings are a repository property, not an author property.
#
# Every text file this repository governs is LF in the object database, so a
# diff shows the change and not the host that produced it. Without this file a
# CRLF checkout commits CRLF blobs and the next one-line edit renders as a
# whole-file diff (see #766: +349/-349 for a 10-line change).
#
# `text=auto` normalises on add. The explicit per-type lines are redundant for
# the object database but make the intent readable and survive `text=auto`
# being turned off for a path by a later rule.

* text=auto

*.rs   text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.html text eol=lf

