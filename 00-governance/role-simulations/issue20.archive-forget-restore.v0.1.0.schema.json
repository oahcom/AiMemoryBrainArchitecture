        "signatureProfileId": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "keyId": {
          "$ref": "#/$defs/OpaqueRef"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ProducerInstanceRef": {
      "type": "object",
      "required": [
        "policyDomainRef",
        "producerDomainRef",
        "producerId",
        "producerInstanceId",
        "identityGeneration"
