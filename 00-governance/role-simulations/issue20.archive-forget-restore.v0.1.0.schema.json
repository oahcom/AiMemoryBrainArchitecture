    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "AuthorityPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "positionRef"
      ],
      "properties": {
        "authority": {
          "enum": [
            "D",
            "I",
            "F",
            "E",
            "G",
            "H",
            "STORAGE",
            "COC",
            "ADAPTER"
          ]
        },
        "positionRef": {
          "$ref": "#/$defs/OpaqueRef"
        }
      }
    },
    "SignedEnvelope": {
      "type": "object",
      "required": [
        "schemaId",
        "schemaVersion",
        "messageId",
        "issuer",
        "audience",
        "issuedAt",
        "signatureProfileId",
        "keyId",
        "signature"
      ],
      "properties": {
        "schemaId": {
          "type": "string",
          "const": "issue20.archive-forget-restore"
        },
        "schemaVersion": {
          "type": "string",
          "const": "0.1.0"
        },
        "messageId": {
          "$ref": "#/$defs/OpaqueRef"
        },
