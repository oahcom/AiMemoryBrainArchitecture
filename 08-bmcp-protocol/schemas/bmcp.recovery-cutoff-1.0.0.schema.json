        "recovery_epoch_ref": {
          "$ref": "#/$defs/ref"
        },
        "recovery_round_ref": {
          "$ref": "#/$defs/ref"
        },
        "recovery_batch_ref": {
          "$ref": "#/$defs/ref"
        },
        "recovery_batch_digest": {
          "$ref": "#/$defs/digest"
        },
        "participant_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/ref"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "request_high_water": {
          "$ref": "#/$defs/counter"
        },
