      "required": [
        "schema_id",
        "schema_version",
        "message_type",
        "message_id",
        "recovery_epoch_ref",
        "final_batch_ref",
        "final_batch_digest",
        "participant_manifest_digest",
        "required_owner_release_refs",
        "all_rounds_root",
        "completion_observation_ref",
        "quorum_commit_proof_ref",
        "envelope"
      ]
