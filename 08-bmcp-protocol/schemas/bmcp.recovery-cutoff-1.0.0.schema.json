{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aimemorybrainarchitecture.invalid/bmcp.recovery-cutoff/1.0.0",
  "title": "BMCP Recovery Cutoff 1.0.0 — owner admission and recovery batch candidate",
  "description": "Strict structural candidate for owner admission snapshots, COC participant manifests, recovery batches, owner admission entries, owner gate releases and recovery epoch completion. Cryptographic and cross-message semantics require separate validators.",
  "oneOf": [
    {
      "$ref": "#/$defs/ownerSnapshot"
    },
    {
      "$ref": "#/$defs/participantManifest"
    },
    {
      "$ref": "#/$defs/recoveryBatch"
    },
    {
      "$ref": "#/$defs/admissionEntry"
    },
    {
      "$ref": "#/$defs/gateRelease"
    },
    {
      "$ref": "#/$defs/epochCompleted"
    }
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "Canonical unsigned decimal string; no leading zeroes. Owner-local namespace only."
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer_ref": {
          "$ref": "#/$defs/ref"
        },
        "subject_ref": {
          "$ref": "#/$defs/ref"
        },
        "owner_authority_ref": {
          "$ref": "#/$defs/ref"
        },
        "audience_ref": {
          "$ref": "#/$defs/ref"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "key_ref": {
          "$ref": "#/$defs/ref"
        },
        "key_version": {
          "$ref": "#/$defs/counter"
        },
        "algorithm_profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "digest_profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "signature_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "issuer_ref",
        "subject_ref",
        "owner_authority_ref",
        "audience_ref",
        "purpose",
        "key_ref",
        "key_version",
        "algorithm_profile_ref",
        "canonicalization_profile_ref",
        "digest_profile_ref",
        "payload_digest",
        "signature_ref"
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admission_ref": {
          "$ref": "#/$defs/ref"
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "entry_digest": {
          "$ref": "#/$defs/digest"
        },
        "coc_registration_state": {
          "enum": [
            "REGISTERED",
            "NOT_REGISTERED"
          ]
        },
        "participant_intent_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_position": {
          "$ref": "#/$defs/ref"
        },
        "participant_entry_digest": {
          "$ref": "#/$defs/digest"
        },
        "not_registered_reason": {
          "type": "string",
          "minLength": 1
        },
        "effect_boundary": {
          "enum": [
            "LOCAL_ACCEPTANCE",
            "RECEIPT_ISSUE",
            "RECEIPT_CONSUME",
            "WORK_ADMISSION",
            "RESERVATION",
            "PROVIDER_ATTEMPT",
            "PUBLICATION",
            "RESTORE_REPLAY",
            "OTHER"
          ]
        },
        "terminal_state": {
          "enum": [
            "PENDING",
            "TERMINAL_SUCCESS",
            "TERMINAL_ABORT",
            "NO_EFFECT_PROVEN",
            "UNKNOWN",
            "IN_DOUBT"
          ]
        }
      },
      "required": [
        "admission_ref",
        "sequence",
        "entry_digest",
        "coc_registration_state",
        "effect_boundary",
        "terminal_state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "coc_registration_state": {
                "const": "REGISTERED"
              }
            },
            "required": [
              "coc_registration_state"
            ]
          },
          "then": {
            "required": [
              "participant_intent_ref",
              "participant_position",
              "participant_entry_digest"
            ],
            "not": {
              "required": [
                "not_registered_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "coc_registration_state": {
                "const": "NOT_REGISTERED"
              }
            },
            "required": [
              "coc_registration_state"
            ]
          },
          "then": {
            "required": [
              "not_registered_reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "participant_intent_ref"
                  ]
                },
                {
                  "required": [
                    "participant_position"
                  ]
                },
                {
                  "required": [
                    "participant_entry_digest"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "ownerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "const": "bmcp.recovery-cutoff"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "OWNER_ADMISSION_SNAPSHOT_ATTESTATION"
        },
        "message_id": {
          "$ref": "#/$defs/ref"
        },
        "owner_kind": {
          "enum": [
            "I",
            "D",
            "C"
          ]
        },
        "gate_ref": {
          "$ref": "#/$defs/ref"
        },
        "gate_generation": {
          "$ref": "#/$defs/counter"
        },
        "scope_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_generation": {
          "$ref": "#/$defs/counter"
        },
        "request_high_water": {
          "$ref": "#/$defs/counter"
        },
        "admission_high_water": {
          "$ref": "#/$defs/counter"
        },
        "secondary_high_waters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/counter"
          }
        },
        "enumeration_status": {
          "enum": [
            "COMPLETE_NON_EMPTY",
            "COMPLETE_EMPTY",
            "NOT_ENUMERATED",
            "PARTIAL",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "uniqueItems": true
        },
        "member_count": {
          "type": "integer",
          "minimum": 0
        },
        "member_set_root": {
          "$ref": "#/$defs/digest"
        },
        "ledger_source_ref": {
          "$ref": "#/$defs/ref"
        },
        "completeness_method_ref": {
          "$ref": "#/$defs/ref"
        },
        "anti_rollback_anchor_ref": {
          "$ref": "#/$defs/ref"
        },
        "recovery_epoch_ref": {
          "$ref": "#/$defs/ref"
        },
        "recovery_round_ref": {
          "$ref": "#/$defs/ref"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "message_type",
        "message_id",
        "owner_kind",
        "gate_ref",
        "gate_generation",
        "scope_binding_digest",
        "snapshot_generation",
        "request_high_water",
        "admission_high_water",
        "enumeration_status",
        "members",
        "member_count",
        "member_set_root",
        "ledger_source_ref",
        "completeness_method_ref",
        "anti_rollback_anchor_ref",
        "recovery_epoch_ref",
        "recovery_round_ref",
        "envelope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enumeration_status": {
                "const": "COMPLETE_EMPTY"
              }
            },
            "required": [
              "enumeration_status"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "maxItems": 0
              },
              "member_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enumeration_status": {
                "const": "COMPLETE_NON_EMPTY"
              }
            },
            "required": [
              "enumeration_status"
            ]
          },
          "then": {
            "properties": {
              "members": {
                "minItems": 1
              },
              "member_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "participantManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "const": "bmcp.recovery-cutoff"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "COC_PARTICIPANT_MANIFEST"
        },
        "message_id": {
          "$ref": "#/$defs/ref"
        },
        "recovery_epoch_ref": {
          "$ref": "#/$defs/ref"
        },
        "prefix_term": {
          "$ref": "#/$defs/counter"
        },
        "prefix_index": {
          "$ref": "#/$defs/counter"
        },
        "prefix_root": {
          "$ref": "#/$defs/digest"
        },
        "enumeration_status": {
          "enum": [
            "COMPLETE_NON_EMPTY",
            "COMPLETE_EMPTY",
            "NOT_ENUMERATED",
            "PARTIAL",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "participant_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "uniqueItems": true
        },
        "participant_count": {
          "type": "integer",
          "minimum": 0
        },
        "participant_set_root": {
          "$ref": "#/$defs/digest"
        },
        "previous_prefix_digest": {
          "$ref": "#/$defs/digest"
        },
        "quorum_commit_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "message_type",
        "message_id",
        "recovery_epoch_ref",
        "prefix_term",
        "prefix_index",
        "prefix_root",
        "enumeration_status",
        "participant_refs",
        "participant_count",
        "participant_set_root",
        "previous_prefix_digest",
        "quorum_commit_proof_ref",
        "envelope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enumeration_status": {
                "const": "COMPLETE_EMPTY"
              }
            },
            "required": [
              "enumeration_status"
            ]
          },
          "then": {
            "properties": {
              "participant_refs": {
                "maxItems": 0
              },
              "participant_count": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enumeration_status": {
                "const": "COMPLETE_NON_EMPTY"
              }
            },
            "required": [
              "enumeration_status"
            ]
          },
          "then": {
            "properties": {
              "participant_refs": {
                "minItems": 1
              },
              "participant_count": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "recoveryBatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "const": "bmcp.recovery-cutoff"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "RECOVERY_CUTOFF_BATCH"
        },
        "message_id": {
          "$ref": "#/$defs/ref"
        },
        "recovery_epoch_ref": {
          "$ref": "#/$defs/ref"
        },
        "recovery_round_ref": {
          "$ref": "#/$defs/ref"
        },
        "prefix_term": {
          "$ref": "#/$defs/counter"
        },
        "prefix_index": {
          "$ref": "#/$defs/counter"
        },
        "prefix_root": {
          "$ref": "#/$defs/digest"
        },
        "participant_manifest_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_snapshot_refs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "I",
              "D",
              "C"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/ref"
          }
        },
        "owner_snapshot_digests": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "I",
              "D",
              "C"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          }
        },
        "scope_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "reconciliation_attempt_generation": {
          "$ref": "#/$defs/counter"
        },
        "previous_batch_digest": {
          "$ref": "#/$defs/digest"
        },
        "batch_digest": {
          "$ref": "#/$defs/digest"
        },
        "quorum_commit_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "message_type",
        "message_id",
        "recovery_epoch_ref",
        "recovery_round_ref",
        "prefix_term",
        "prefix_index",
        "prefix_root",
        "participant_manifest_ref",
        "participant_manifest_digest",
        "owner_snapshot_refs",
        "owner_snapshot_digests",
        "scope_binding_digest",
        "reconciliation_attempt_generation",
        "batch_digest",
        "quorum_commit_proof_ref",
        "envelope"
      ]
    },
    "admissionEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
