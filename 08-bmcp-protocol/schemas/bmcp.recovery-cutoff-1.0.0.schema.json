          "const": "bmcp.recovery-cutoff"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "message_type": {
          "const": "OWNER_ADMISSION_ENTRY"
        },
        "message_id": {
          "$ref": "#/$defs/ref"
        },
        "owner_kind": {
          "enum": [
            "I",
            "D",
            "C"
          ]
        },
        "admission_ref": {
          "$ref": "#/$defs/ref"
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "entry_digest": {
          "$ref": "#/$defs/digest"
        },
        "coc_registration_state": {
          "enum": [
            "REGISTERED",
            "NOT_REGISTERED"
          ]
        },
        "participant_intent_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_position": {
          "$ref": "#/$defs/ref"
        },
        "participant_entry_digest": {
          "$ref": "#/$defs/digest"
        },
        "not_registered_reason": {
          "type": "string",
          "minLength": 1
        },
        "effect_boundary": {
          "enum": [
            "LOCAL_ACCEPTANCE",
            "RECEIPT_ISSUE",
            "RECEIPT_CONSUME",
            "WORK_ADMISSION",
            "RESERVATION",
            "PROVIDER_ATTEMPT",
            "PUBLICATION",
            "RESTORE_REPLAY",
            "OTHER"
          ]
        },
        "terminal_state": {
          "enum": [
            "PENDING",
            "TERMINAL_SUCCESS",
            "TERMINAL_ABORT",
            "NO_EFFECT_PROVEN",
            "UNKNOWN",
            "IN_DOUBT"
          ]
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "message_type",
        "message_id",
        "owner_kind",
        "admission_ref",
        "sequence",
        "entry_digest",
        "coc_registration_state",
        "effect_boundary",
        "terminal_state",
        "envelope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "coc_registration_state": {
                "const": "REGISTERED"
              }
            },
            "required": [
              "coc_registration_state"
            ]
          },
          "then": {
            "required": [
              "participant_intent_ref",
              "participant_position",
              "participant_entry_digest"
            ],
            "not": {
              "required": [
                "not_registered_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "coc_registration_state": {
                "const": "NOT_REGISTERED"
              }
            },
            "required": [
              "coc_registration_state"
            ]
          },
          "then": {
            "required": [
              "not_registered_reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "participant_intent_ref"
                  ]
                },
                {
                  "required": [
                    "participant_position"
                  ]
                },
                {
                  "required": [
                    "participant_entry_digest"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
