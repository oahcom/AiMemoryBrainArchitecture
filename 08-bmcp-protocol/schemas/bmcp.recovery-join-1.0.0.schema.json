{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aimemorybrainarchitecture.invalid/bmcp.recovery-join/1.0.0",
  "title": "BMCP Recovery Join Proof 1.0.0 — candidate",
  "description": "Strict structural candidate for the bidirectional join between COC ParticipantManifest and I/D/C Owner Admission ledgers. Cross-message semantics, canonical bytes and cryptographic verification require runtime validators.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "bmcp.recovery-join"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "message_type": {
      "const": "RECOVERY_JOIN_PROOF"
    },
    "message_id": {
      "$ref": "#/$defs/ref"
    },
    "recovery_epoch_ref": {
      "$ref": "#/$defs/ref"
    },
    "recovery_round": {
      "type": "integer",
      "minimum": 1
    },
    "reconciliation_attempt_generation": {
      "$ref": "#/$defs/counter"
    },
    "causal_order_domain_ref": {
      "$ref": "#/$defs/ref"
    },
    "scope_ref": {
      "$ref": "#/$defs/ref"
    },
    "scope_generation": {
      "$ref": "#/$defs/counter"
    },
    "recovery_cutoff_batch_ref": {
      "$ref": "#/$defs/ref"
    },
    "recovery_batch_digest": {
      "$ref": "#/$defs/digest"
    },
    "participant_manifest_ref": {
      "$ref": "#/$defs/ref"
    },
    "participant_manifest_content_digest": {
      "$ref": "#/$defs/digest"
    },
    "participant_manifest_record_digest": {
      "$ref": "#/$defs/digest"
    },
    "coc_prefix": {
      "$ref": "#/$defs/prefix"
    },
    "owner_snapshots": {
      "$ref": "#/$defs/ownerSnapshots"
    },
    "owner_admission_to_participant": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/admissionJoin"
      },
      "uniqueItems": true
    },
    "owner_admission_no_participant": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/noParticipantDisposition"
      },
      "uniqueItems": true
    },
    "participant_to_owner_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participantEvidenceJoin"
      },
      "uniqueItems": true
    },
    "jf10_participant_joins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jf10Join"
      },
      "uniqueItems": true
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "difference_sets": {
      "$ref": "#/$defs/differenceSets"
    },
    "join_root": {
      "$ref": "#/$defs/digest"
    },
    "canonicalization_profile_ref": {
      "$ref": "#/$defs/ref"
    },
    "digest_profile_ref": {
      "$ref": "#/$defs/ref"
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "owner_request_dispositions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requestDisposition"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "message_type",
    "message_id",
    "recovery_epoch_ref",
    "recovery_round",
    "reconciliation_attempt_generation",
    "causal_order_domain_ref",
    "scope_ref",
    "scope_generation",
    "recovery_cutoff_batch_ref",
    "recovery_batch_digest",
    "participant_manifest_ref",
    "participant_manifest_content_digest",
    "participant_manifest_record_digest",
    "coc_prefix",
    "owner_snapshots",
    "owner_admission_to_participant",
    "owner_admission_no_participant",
    "participant_to_owner_evidence",
    "jf10_participant_joins",
    "completeness",
    "difference_sets",
    "join_root",
    "canonicalization_profile_ref",
    "digest_profile_ref",
    "envelope",
    "owner_request_dispositions"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counter": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "term": {
          "$ref": "#/$defs/counter"
        },
        "index": {
          "$ref": "#/$defs/counter"
        },
        "entry_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "term",
        "index",
        "entry_digest"
      ]
    },
    "prefix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "term": {
          "$ref": "#/$defs/counter"
        },
        "index": {
          "$ref": "#/$defs/counter"
        },
        "root": {
          "$ref": "#/$defs/digest"
        },
        "configuration_epoch": {
          "$ref": "#/$defs/counter"
        },
        "previous_prefix_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "term",
        "index",
        "root",
        "configuration_epoch",
        "previous_prefix_digest"
      ]
    },
    "ownerSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_authority_ref": {
          "$ref": "#/$defs/ref"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/ref"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "request_count": {
          "type": "integer",
          "minimum": 0
        },
        "request_root": {
          "$ref": "#/$defs/digest"
        },
        "request_highwaters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/counter"
          }
        },
        "admission_count": {
          "type": "integer",
          "minimum": 0
        },
        "admission_root": {
          "$ref": "#/$defs/digest"
        },
        "admission_highwaters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/counter"
          }
        },
        "gate_ref": {
          "$ref": "#/$defs/ref"
        },
        "gate_generation": {
          "$ref": "#/$defs/counter"
        },
        "scope_generation": {
          "$ref": "#/$defs/counter"
        },
        "anti_rollback_anchor_ref": {
          "$ref": "#/$defs/ref"
        },
        "signature_ref": {
          "$ref": "#/$defs/ref"
        },
        "request_enumeration_status": {
          "enum": [
            "COMPLETE_EMPTY",
            "COMPLETE_NON_EMPTY",
            "PARTIAL",
            "NOT_ENUMERATED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        },
        "admission_enumeration_status": {
          "enum": [
            "COMPLETE_EMPTY",
            "COMPLETE_NON_EMPTY",
            "PARTIAL",
            "NOT_ENUMERATED",
            "UNAVAILABLE",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "owner_authority_ref",
        "snapshot_ref",
        "snapshot_digest",
        "request_count",
        "request_root",
        "request_highwaters",
        "admission_count",
        "admission_root",
        "admission_highwaters",
        "gate_ref",
        "gate_generation",
        "scope_generation",
        "anti_rollback_anchor_ref",
        "signature_ref",
        "request_enumeration_status",
        "admission_enumeration_status"
      ]
    },
    "ownerSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "I": {
          "$ref": "#/$defs/ownerSnapshot"
        },
        "D": {
          "$ref": "#/$defs/ownerSnapshot"
        },
        "C": {
          "$ref": "#/$defs/ownerSnapshot"
        }
      },
      "required": [
        "I",
        "D",
        "C"
      ]
    },
    "admissionJoin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_kind": {
          "enum": [
            "I",
            "D",
            "C"
          ]
        },
        "owner_admission_ref": {
          "$ref": "#/$defs/ref"
        },
        "owner_admission_entry_digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_sequence_namespace": {
          "$ref": "#/$defs/ref"
        },
        "owner_sequence": {
          "$ref": "#/$defs/counter"
        },
        "gate_generation": {
          "$ref": "#/$defs/counter"
        },
        "scope_generation": {
          "$ref": "#/$defs/counter"
        },
        "operation_identity_ref": {
          "$ref": "#/$defs/ref"
        },
        "operation_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_intent_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_position": {
          "$ref": "#/$defs/position"
        },
        "participant_manifest_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_manifest_record_digest": {
          "$ref": "#/$defs/digest"
        },
        "cardinality_rule_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_position_ref": {
          "$ref": "#/$defs/ref"
        },
        "owner_entry_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "owner_kind",
        "owner_admission_ref",
        "owner_admission_entry_digest",
        "owner_sequence_namespace",
        "owner_sequence",
        "gate_generation",
        "scope_generation",
        "operation_identity_ref",
        "operation_digest",
        "scope_ref",
        "participant_intent_ref",
        "participant_position",
        "participant_manifest_ref",
        "participant_manifest_record_digest",
        "cardinality_rule_ref",
        "participant_position_ref",
        "owner_entry_ref"
      ]
    },
    "noParticipantDisposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_kind": {
          "enum": [
            "I",
            "D",
            "C"
          ]
        },
        "owner_admission_ref": {
          "$ref": "#/$defs/ref"
        },
        "owner_admission_entry_digest": {
          "$ref": "#/$defs/digest"
        },
        "owner_sequence_namespace": {
          "$ref": "#/$defs/ref"
        },
        "owner_sequence": {
          "$ref": "#/$defs/counter"
        },
        "registration_state": {
          "const": "NOT_REGISTERED"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "terminal_state": {
          "enum": [
            "NO_EFFECT_PROVEN",
            "PENDING",
            "UNKNOWN",
            "IN_DOUBT"
          ]
        },
        "no_effect_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "owner_signature_ref": {
          "$ref": "#/$defs/ref"
        },
        "owner_entry_ref": {
          "$ref": "#/$defs/ref"
        },
        "operation_identity_ref": {
          "$ref": "#/$defs/ref"
        },
        "operation_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope_ref": {
          "$ref": "#/$defs/ref"
        },
        "gate_generation": {
          "$ref": "#/$defs/counter"
        },
        "scope_generation": {
          "$ref": "#/$defs/counter"
        }
      },
      "required": [
        "owner_kind",
        "owner_admission_ref",
        "owner_admission_entry_digest",
        "owner_sequence_namespace",
        "owner_sequence",
        "registration_state",
        "reason",
        "terminal_state",
        "owner_signature_ref",
        "owner_entry_ref",
        "operation_identity_ref",
        "operation_digest",
        "scope_ref",
        "gate_generation",
        "scope_generation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_state": {
                "const": "NO_EFFECT_PROVEN"
              }
            },
            "required": [
              "terminal_state"
            ]
          },
          "then": {
            "required": [
              "no_effect_proof_ref"
            ]
          }
        }
      ]
    },
    "participantEvidenceJoin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participant_intent_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_digest": {
          "$ref": "#/$defs/digest"
        },
        "participant_position": {
          "$ref": "#/$defs/position"
        },
        "primary_owner_kind": {
          "const": "C"
        },
        "primary_owner_admission_ref": {
          "$ref": "#/$defs/ref"
        },
        "required_owner_set": {
          "type": "array",
          "items": {
            "enum": [
              "I",
              "D",
              "C",
              "STORAGE"
            ]
          },
          "uniqueItems": true
        },
        "owner_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownerEvidence"
          },
          "uniqueItems": true
        },
        "primary_owner_entry_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "participant_intent_ref",
        "participant_digest",
        "participant_position",
        "primary_owner_kind",
        "primary_owner_admission_ref",
        "required_owner_set",
        "owner_evidence",
        "primary_owner_entry_ref"
      ]
    },
    "ownerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_kind": {
          "enum": [
            "I",
            "D",
            "C",
            "STORAGE"
          ]
        },
        "evidence_kind": {
          "enum": [
            "ADMISSION",
            "RECEIPT_ISSUE",
            "RECEIPT_CONSUME",
            "TERMINAL_PROOF",
            "WORK_ITEM",
            "ATTEMPT",
            "BARRIER_MEMBERSHIP",
            "LINEAGE",
            "RESERVATION",
            "PROVIDER_ATTEMPT",
            "PROVIDER_OUTCOME",
            "PREPARED_PARTICIPANT",
            "STORAGE_RESOLUTION",
            "NOT_APPLICABLE_PROOF"
          ]
        },
        "evidence_ref": {
          "$ref": "#/$defs/ref"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "disposition": {
          "enum": [
            "PRESENT",
            "NOT_APPLICABLE_WITH_PROOF",
            "PENDING",
            "UNKNOWN"
          ]
        },
        "not_applicable_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "forget_operation_ref": {
          "$ref": "#/$defs/ref"
        },
        "fence_generation": {
          "$ref": "#/$defs/counter"
        },
        "lineage_manifest_ref": {
          "$ref": "#/$defs/ref"
        },
        "lineage_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "barrier_member_ref": {
          "$ref": "#/$defs/ref"
        },
        "producer_work_item_ref": {
          "$ref": "#/$defs/ref"
        },
        "attempt_ref": {
          "$ref": "#/$defs/ref"
        },
        "terminal_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "policy_domain_ref": {
          "$ref": "#/$defs/ref"
        },
        "permission_epoch": {
          "$ref": "#/$defs/counter"
        },
        "producer_domain_inventory_epoch": {
          "$ref": "#/$defs/counter"
        },
        "receipt_nonce": {
          "$ref": "#/$defs/ref"
        },
        "issuer_key_ref": {
          "$ref": "#/$defs/ref"
        },
        "authorization_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "provider_attempt_ref": {
          "$ref": "#/$defs/ref"
        },
        "reservation_ref": {
          "$ref": "#/$defs/ref"
        },
        "provider_outcome_ref": {
          "$ref": "#/$defs/ref"
        },
        "idempotency_key_ref": {
          "$ref": "#/$defs/ref"
        },
        "provider_effect_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_participant_ref": {
          "$ref": "#/$defs/ref"
        },
        "prepared_transaction_gid": {
          "$ref": "#/$defs/ref"
        },
        "database_incarnation_ref": {
          "$ref": "#/$defs/ref"
        },
        "storage_resolution_proof_ref": {
          "$ref": "#/$defs/ref"
        }
      },
      "required": [
        "owner_kind",
        "evidence_kind",
        "evidence_ref",
        "evidence_digest",
        "disposition"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "owner_kind": {
                "const": "D"
              },
              "evidence_kind": {
                "enum": [
                  "LINEAGE",
                  "BARRIER_MEMBERSHIP"
                ]
              }
            },
            "required": [
              "owner_kind",
              "evidence_kind"
            ]
          },
          "then": {
            "required": [
              "forget_operation_ref",
              "fence_generation",
              "lineage_manifest_ref",
              "lineage_manifest_digest",
              "barrier_member_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "owner_kind": {
                "const": "I"
              },
              "evidence_kind": {
                "enum": [
                  "RECEIPT_ISSUE",
                  "RECEIPT_CONSUME",
                  "TERMINAL_PROOF"
                ]
              }
            },
            "required": [
              "owner_kind",
              "evidence_kind"
            ]
          },
          "then": {
            "required": [
              "policy_domain_ref",
              "permission_epoch",
              "producer_domain_inventory_epoch",
              "issuer_key_ref",
              "authorization_receipt_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "owner_kind": {
                "const": "C"
              },
              "evidence_kind": {
                "enum": [
                  "PROVIDER_ATTEMPT",
                  "PROVIDER_OUTCOME"
                ]
              }
            },
            "required": [
              "owner_kind",
              "evidence_kind"
            ]
          },
          "then": {
            "required": [
              "reservation_ref",
              "provider_attempt_ref",
              "idempotency_key_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "owner_kind": {
                "const": "STORAGE"
              },
              "evidence_kind": {
                "enum": [
                  "PREPARED_PARTICIPANT",
                  "STORAGE_RESOLUTION"
                ]
              }
            },
            "required": [
              "owner_kind",
              "evidence_kind"
            ]
          },
          "then": {
            "required": [
              "prepared_participant_ref",
              "prepared_transaction_gid",
              "database_incarnation_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "NOT_APPLICABLE_WITH_PROOF"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "not_applicable_proof_ref"
            ]
          }
        }
      ]
    },
    "jf10Join": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participant_intent_ref": {
          "$ref": "#/$defs/ref"
        },
        "causal_order_transaction_ref": {
          "$ref": "#/$defs/ref"
        },
        "publication_operation_id": {
          "$ref": "#/$defs/ref"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "participant_tuple_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepared_participant_ref": {
          "$ref": "#/$defs/ref"
        },
        "prepared_transaction_gid": {
          "$ref": "#/$defs/ref"
        },
        "canonical_authority_db_ref": {
          "$ref": "#/$defs/ref"
        },
        "database_incarnation_ref": {
          "$ref": "#/$defs/ref"
        },
        "postgres_cluster_system_identifier": {
          "type": "string",
          "minLength": 1
        },
        "database_oid": {
          "$ref": "#/$defs/counter"
        },
        "postgresql_native_xid_observed": {
          "$ref": "#/$defs/counter"
        },
        "prepare_attempt_ref": {
          "$ref": "#/$defs/ref"
        },
        "prepare_attempt_generation": {
          "$ref": "#/$defs/counter"
        },
        "participant_ledger_ref": {
          "$ref": "#/$defs/ref"
        },
        "participant_ledger_version": {
          "$ref": "#/$defs/counter"
        },
        "coc_prepare_intent_position": {
          "$ref": "#/$defs/position"
        },
        "i_commit_authorization_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "i_terminal_state": {
          "enum": [
            "COMMIT_WON",
            "REVOCATION_WON",
            "INDETERMINATE_ABORTED",
            "UNKNOWN",
            "IN_DOUBT"
          ]
        },
        "storage_prepared_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "storage_resolution_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "storage_terminal_state": {
          "enum": [
            "COMMITTED",
            "ROLLED_BACK",
            "UNKNOWN",
            "IN_DOUBT"
          ]
        }
      },
      "required": [
        "participant_intent_ref",
        "causal_order_transaction_ref",
        "publication_operation_id",
        "request_digest",
        "participant_tuple_digest",
        "prepared_participant_ref",
        "prepared_transaction_gid",
        "canonical_authority_db_ref",
        "database_incarnation_ref",
        "postgres_cluster_system_identifier",
        "database_oid",
        "prepare_attempt_ref",
        "prepare_attempt_generation",
        "participant_ledger_ref",
        "participant_ledger_version",
        "coc_prepare_intent_position",
        "i_commit_authorization_receipt_ref",
        "i_terminal_state",
        "storage_prepared_receipt_ref",
        "storage_terminal_state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "storage_terminal_state": {
                "enum": [
                  "COMMITTED",
                  "ROLLED_BACK"
                ]
              }
            },
            "required": [
              "storage_terminal_state"
            ]
          },
          "then": {
            "required": [
              "storage_resolution_proof_ref"
            ]
          }
        }
      ]
